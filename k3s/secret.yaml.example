# for Backend
apiVersion: v1
kind: Secret
metadata:
  name: back-secret
  namespace: chat-messenger
type: Opaque
stringData:
  DB_HOST: bd
  DB_PORT: "5432"
  DB_USER: CHANGE_ME
  DB_PASSWORD: CHANGE_ME
  DB_NAME: CHANGE_ME
  REDIS_HOST: CHANGE_ME
  REDIS_PORT: "6379"
---
#FOR pgAdmin
apiVersion: v1
kind: Secret
metadata:
  name: pgadmin-secret
  namespace: chat-messenger
type: Opaque
stringData:
  PGADMIN_DEFAULT_EMAIL: CHANGE_ME
  PGADMIN_DEFAULT_PASSWORD: CHANGE_ME

---
#for database
apiVersion: v1
kind: Secret
metadata:
  name: db-secret
  namespace: chat-messenger
type: Opaque
stringData:
  POSTGRES_USER: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME
  POSTGRES_DB: chatdb

---
#for redis
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: chat-messenger
type: Opaque
stringData:
  REDIS_HOST: redis
  REDIS_PORT: "6379"